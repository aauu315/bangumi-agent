# Optional developer environment input; this file is not loaded automatically.
# CLI defaults to .secrets/bangumi-token.txt; use --prompt-token for hidden input.
# Never paste a real token into this example or the chat.
BANGUMI_ACCESS_TOKEN=
# Model API keys are not read from the environment. Save them once with
# scripts\agent_chat.py --save-key [--provider anthropic]; they go to .secrets/<provider>-api-key.txt.
